<Window x:Class="CozyBreak.WaterPetOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CozyBreak Hydration Alert"
        Height="80"
        Width="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid>
        <Border Background="#FFFDF8"
                BorderBrush="#D28B68"
                BorderThickness="2"
                CornerRadius="8"
                Padding="8"
                Margin="60,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtDose" Text="Hora da água! 200 ml" FontWeight="Bold" FontSize="12" Foreground="#514238" />
                    <TextBlock Text="Pausa para hidratar o organismo." FontSize="10" Foreground="#806F63" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tomei" Click="Drink_Click" Background="#D28B68" Foreground="White" Padding="6,2" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="+5m" Click="Snooze_Click" Background="#E8DDD5" Foreground="#514238" Padding="6,2" BorderThickness="0" Cursor="Hand" ToolTip="Adiar por 5 minutos" />
                </StackPanel>
            </Grid>
        </Border>
        <Canvas x:Name="PetCanvas"
                Width="56" Height="56"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Panel.ZIndex="10"
                RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Rectangle Canvas.Left="8" Canvas.Top="22" Width="30" Height="18" Fill="#BE825C" />
            <Rectangle Canvas.Left="28" Canvas.Top="14" Width="18" Height="20" Fill="#BE825C" />
            <Rectangle Canvas.Left="31" Canvas.Top="9" Width="10" Height="10" Fill="#EBA39D" />
            <Rectangle Canvas.Left="43" Canvas.Top="18" Width="7" Height="7" Fill="#704630" />
            <Rectangle Canvas.Left="39" Canvas.Top="16" Width="4" Height="4" Fill="#231916" />
            <Rectangle Canvas.Left="14" Canvas.Top="40" Width="6" Height="11" Fill="#704630" />
            <Rectangle Canvas.Left="31" Canvas.Top="40" Width="6" Height="11" Fill="#704630" />
            <Rectangle Canvas.Left="2" Canvas.Top="22" Width="9" Height="5" Fill="#BE825C" />
        </Canvas>
    </Grid>
</Window>
